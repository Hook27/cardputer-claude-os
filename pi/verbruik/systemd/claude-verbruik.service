[Unit]
# Verbruikserver: serveert de Claude-limieten kaal op het LAN, zodat de
# Cardputer ze kan tonen zonder zelf een token te dragen.
Description=Claude verbruikserver voor de Cardputer
Documentation=https://github.com/Hook27/cardputer-claude-os
# Let op: dit is een *user*-unit, en network-online.target is een systeemtarget
# dat de user-manager niet kent — deze twee regels doen hier vermoedelijk niets.
# Ze staan er voor het geval iemand hier een systeem-unit van maakt, en ze zijn
# onschadelijk. Wachten op netwerk is ook niet nodig gebleken: binden op
# 0.0.0.0 lukt zonder netwerk, en een mislukte eerste ophaalpoging degradeert
# netjes (bron wordt "fout"/"geen-token") en wordt binnen de cachetijd vanzelf
# opnieuw geprobeerd. Bij een reboot-test op TaSc-Pi5 stond de live data zes
# seconden na de start van de unit al klaar.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/claude-verbruik/claude_verbruik_server.py --poort 8091
# De server is read-only op de credentials en kan zonder verlies herstart
# worden; opnieuw proberen is dus altijd goed. 10 s zodat een Pi die net
# opstart niet in een snelle herstartlus komt.
Restart=on-failure
RestartSec=10
# Bescheiden afscherming. Dit is een user-unit, dus de zwaardere opties
# (ProtectSystem=strict e.d.) doen hier weinig; deze twee werken wel.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
